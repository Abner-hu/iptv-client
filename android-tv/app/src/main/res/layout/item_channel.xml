<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/channelCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/channel_selector"
    android:clickable="true"
    android:duplicateParentState="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/channelLogo"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="#1C1917"
        android:contentDescription="@null"
        android:focusable="false"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_channel_default" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/channelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F5F5F4"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/channelGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#A8A29E"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
