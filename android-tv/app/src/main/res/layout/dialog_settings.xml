<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="8dp"
    android:paddingRight="16dp"
    android:paddingBottom="8dp">

    <Button
        android:id="@+id/settingsRecent"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="#D97706"
        android:focusable="true"
        android:nextFocusDown="@id/settingsImport"
        android:text="最近播放"
        android:textColor="#1C1917"
        android:textSize="18sp" />

    <Button
        android:id="@+id/settingsImport"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#292524"
        android:focusable="true"
        android:nextFocusUp="@id/settingsRecent"
        android:nextFocusDown="@id/settingsClear"
        android:text="导入 M3U"
        android:textColor="#F5F5F4"
        android:textSize="18sp" />

    <Button
        android:id="@+id/settingsClear"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#7F1D1D"
        android:focusable="true"
        android:nextFocusUp="@id/settingsImport"
        android:text="清除 M3U"
        android:textColor="#FECACA"
        android:textSize="18sp" />
</LinearLayout>
