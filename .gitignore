# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
*.apk
!public/iptv-client.v*.apk
!release/iptv-client.v*.apk
/release/*.exe
!release/IPTV-Client-*-portable.exe
/release/*.zip
/release/win-unpacked/
/release/*.blockmap
/release/*.yml

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# cursor
agent-tools/
scripts/__pycache__/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
