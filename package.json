{
  "name": "iptv-terminal",
  "version": "1.0.20",
  "private": true,
  "main": "electron/main.cjs",
  "author": "Abner Hu",
  "description": "IPTV Client desktop player",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 43217",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 43217",
    "lint": "eslint",
    "desktop": "electron .",
    "dist:win": "bash scripts/build-win-exe.sh",
    "apk": "bash scripts/build-tv-apk.sh"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.1",
    "lucide-react": "^1.38.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.iptv.terminal",
    "productName": "IPTV Client",
    "copyright": "Copyright © 2026 Abner Hu",
    "asar": true,
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*",
          "**/node_modules/**",
          "!**/*.map"
        ]
      }
    ],
    "afterPack": "electron/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "electron/icon.ico",
      "signExecutable": false,
      "artifactName": "IPTV-Client-${version}-win-x64.${ext}",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "IPTV-Client-${version}-portable.exe"
    }
  }
}
